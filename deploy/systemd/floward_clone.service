[Unit]
Description=yarn_guy Gunicorn daemon
After=network.target

[Service]
User=www-data
Group=www-data
RuntimeDirectory=yarn_guy
RuntimeDirectoryMode=0755
WorkingDirectory=/var/www/yarn_guy
EnvironmentFile=/var/www/yarn_guy/.env
Environment=DJANGO_SETTINGS_MODULE=yarn_guy.settings.prod
ExecStart=/var/www/yarn_guy/.venv/bin/gunicorn \
    -c deploy/gunicorn/gunicorn.conf.py \
    yarn_guy.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
